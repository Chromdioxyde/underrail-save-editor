# Copy to .env.local (not in git) and fill in the paths of this machine.
# The editor itself finds the game and the saves on its own (paths.py); these are for development.

# Underrail installation and the folder with the save games (used when analysing game files and saves)
UNDERRAIL_GAME_DIR=
UNDERRAIL_SAVES_DIR=

# save folders that must never be modified while testing, separated by |
PROTECTED_SAVES=

# packaging/build-appimage.sh copies the finished AppImage here (replacing the older one), if set
APPIMAGE_COPY_DIR=
